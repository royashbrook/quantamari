{
  "name": "quarkatamari",
  "version": "2.3.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite dev",
    "prebuild": "node scripts/clean.mjs && node scripts/build-rescue.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "npm run check",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:artifact": "node --test tests/artifact/*.test.mjs",
    "test:e2e": "npm run build && npm run test:artifact && playwright test",
    "test:all": "npm run check && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "22.19.19",
    "@types/three": "0.185.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
